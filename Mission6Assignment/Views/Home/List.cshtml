@using Mission6Assignment.Models
@model List<Movie>

@{
    var categories = ViewBag.Categories as List<Category>;
}

<h1>Welcome to the Movie List!</h1>
<a class="btn btn-dark" asp-controller="Home" asp-action="Form">Add a movie</a>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited?</th>
            <th>Lent To</th>
            <th>Notes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            var cat = categories?.FirstOrDefault(c => c.CategoryId == movie.CategoryId);

            <tr>
                <td>@movie.Title</td>
                <td>@(cat?.CategoryName ?? "Unknown")</td>
                <td>@movie.Year</td>
                <td>@movie.Director</td>
                <td>@movie.Rating</td>
                <td>@movie.Edited</td>
                <td>@movie.LentTo</td>
                <td>@movie.Notes</td>
                <td>
                    <a class="btn btn-success"
                       asp-controller="Home"
                       asp-action="Edit"
                       asp-route-id="@movie.MovieId">
                        Edit
                    </a>
                    <a class="btn btn-warning"
                       asp-controller="Home"
                       asp-action="Delete"
                       asp-route-id="@movie.MovieId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
