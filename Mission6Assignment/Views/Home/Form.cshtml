@{
    ViewData["Title"] = "Form";
}
@model Form
<h1>Record a movie below</h1>
<form asp-action="Form" asp-controller="Home" method="POST">
    <label asp-for="Title">Title</label>
    <input required asp-for="Title" class="form-control" />
    <label asp-for="Category">Category</label>
    <input required asp-for="Category" class="form-control" />
    <label asp-for="Year">Year</label>"
    <input required asp-for="Year" class="form-control" />
    <label asp-for="Director">Director</label>
    <input required asp-for="Director" />
    <label asp-for="Rating">Rating</label>"
    <select required asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="NR">NR</option>
        <option value="UR">UR</option>
    </select>
    <label asp-for="isEdited">Is it Edited?</label>
    <select asp-for="isEdited">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <label asp-for="Lent">Lent To:</label>
    <input asp-for="Lent" />
    <label asp-for="Notes">Notes</label>
    <input maxlength = "25" asp-for="Notes" />
    
    <button type="submit">Submit</button>

</form>