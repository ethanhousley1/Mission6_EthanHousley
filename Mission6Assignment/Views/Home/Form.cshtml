@using Mission6Assignment.Models
@model Movie

@{
    ViewData["Title"] = "Form";
}

<h1>Record a movie below</h1>

<form asp-action="Form" asp-controller="Home" method="post">
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <input asp-for="MovieId" type="hidden" />

    <label asp-for="Title">Title</label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>

    <label asp-for="CategoryId">Category</label>
    <select asp-for="CategoryId"
            asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))"
            class="form-control">
        <option value="">Select a category</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>

    <label asp-for="Year">Year</label>
    <input asp-for="Year" class="form-control" />
    <span asp-validation-for="Year" class="text-danger"></span>

    <label asp-for="Director">Director</label>
    <input asp-for="Director" class="form-control" />
    <span asp-validation-for="Director" class="text-danger"></span>

    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating" class="form-control">
        <option value="">Select a rating</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="NR">NR</option>
        <option value="UR">UR</option>
    </select>
    <span asp-validation-for="Rating" class="text-danger"></span>

    <label asp-for="Edited">Is it Edited?</label>
    <select asp-for="Edited" class="form-control">
        <option value="0">No</option>
        <option value="1">Yes</option>
    </select>

    <label asp-for="CopiedToPlex">Copied to Plex?</label>
    <select asp-for="CopiedToPlex" class="form-control">
        <option value="0">No</option>
        <option value="1">Yes</option>
    </select>

    <label asp-for="LentTo">Lent To</label>
    <input asp-for="LentTo" class="form-control" />
    <span asp-validation-for="LentTo" class="text-danger"></span>

    <label asp-for="Notes">Notes</label>
    <input asp-for="Notes" class="form-control" maxlength="25" />
    <span asp-validation-for="Notes" class="text-danger"></span>

    <button type="submit" class="btn btn-primary mt-3">Submit</button>
</form>
